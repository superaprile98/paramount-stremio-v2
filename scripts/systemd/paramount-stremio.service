[Unit]
Description=Paramount+ Stremio Addon (Next.js)
Documentation=https://github.com/superparile/paramount-stremio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=addon
Group=addon
WorkingDirectory=/home/ubuntu/paramount-stremio
EnvironmentFile=/etc/paramount-stremio/paramount-stremio.env
ExecStartPre=/usr/bin/env node -e "console.log('starting paramount-stremio...')"
ExecStart=/usr/bin/node /home/ubuntu/paramount-stremio/node_modules/next/dist/bin/next start -H 0.0.0.0 -p ${PORT}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillMode=mixed
KillSignal=SIGTERM

# Sicurezza: limita visibilità filesystem
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/home/ubuntu/paramount-stremio /var/log/paramount-stremio
PrivateTmp=yes
NoNewPrivileges=yes

# Limiti risorse.
# Next start è leggero (≈ 150 MB RSS) ma il proxy HLS in streaming può salire.
# Su VM con 1 GB RAM (A1.Flex) era necessario un cap a 900M per evitare OOM;
# con 2+ GB RAM rimuoviamo MemoryMax e lasciamo che usi la memoria disponibile.
# Per riattivare il cap su VM piccole, fai:
#   sudo systemctl edit paramount-stremio
# e aggiungi:   [Service]   MemoryMax=900M
LimitNOFILE=65535
# MemoryMax=  (intentionally commented: richiede VM con abbastanza RAM)

[Install]
WantedBy=multi-user.target
