# Copia questo file in .env e inserisci i tuoi valori reali.
# Il file .env NON va committato (è in .gitignore).

# Chiave per cifrare le sessioni JWE (obbligatoria)
# Genera una con: openssl rand -hex 32
KEY_SECRET=change-me

# Proxy HTTP/HTTPS/SOCKS5 per le chiamate verso Paramount+ (opzionale)
# Esempio Webshare con IP auth: http://IP:PORTA
# Esempio con credenziali: http://user:pass@host:port
HTTP_PROXY=

# URL base raggiungibile dai tuoi dispositivi.
# - Sviluppo locale (Stremio DESKTOP sullo stesso PC): http://localhost:7850
# - LAN (TV/telefono sullo stesso router): http://<IP-LAN>:7850
#   Stremio desktop potrebbe mostrare "Failed to fetch" per mixed content
#   se apri /configure via HTTPS (vedi README § Troubleshooting).
# - PRODUZIONE (Oracle Cloud, VPS, dominio pubblico):
#     http://<pub-ip>:7850          (no TLS, porta 7850 esposta)
#     https://addon.example.com     (consigliato, con nginx davanti)
BASE_URL=http://localhost:7850

# Opzionali
PORT=7850
FORCE_HQ=
MFP_URL=
MFP_PASS=
