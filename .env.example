# Copia questo file in .env e inserisci i tuoi valori reali.
# Il file .env NON va committato (è in .gitignore).

# Chiave per cifrare le sessioni JWE (obbligatoria)
# Genera una con: openssl rand -hex 32
KEY_SECRET=change-me

# Proxy HTTP/HTTPS/SOCKS5 per le chiamate verso Paramount+ (opzionale)
# Esempio Webshare con IP auth: http://IP:PORTA
# Esempio con credenziali: http://user:pass@host:port
HTTP_PROXY=

# URL base raggiungibile dai tuoi dispositivi.
# - Per Stremio DESKTOP sullo stesso PC: usa http://localhost:7850 (esente dal
#   blocco mixed-content HTTPS->HTTP di Chromium).
# - Per TV/telefono nella LAN: usa http://<IP-LAN-PC>:7850 (es. 192.168.1.50).
#   In questo caso Stremio desktop potrebbe mostrare "Failed to fetch" sul
#   desktop a causa del mixed content (vedi README § Troubleshooting).
BASE_URL=http://localhost:7850

# Opzionali
PORT=7850
FORCE_HQ=
MFP_URL=
MFP_PASS=