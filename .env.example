# Copia questo file in .env e inserisci i tuoi valori reali.
# Il file .env NON va committato (è in .gitignore).

# Chiave per cifrare le sessioni JWE (obbligatoria)
# Genera una con: openssl rand -hex 32
KEY_SECRET=change-me

# Proxy per le chiamate verso Paramount+.
# PROXY_URLS: lista di proxy separati da virgola. L'addon li usa in
# round-robin e fa fallback automatico se uno restituisce 402 (bandwidth
# limit) o errori di connessione. Formati supportati:
#   http://host:porta
#   https://host:porta
#   socks5://host:porta
#   http://user:pass@host:porta
#
# Con docker compose il default è http://sing-box:8888 (il container
# sing-box che fa da proxy VLESS/Hysteria2/VMess/Trojan/SS). Il failover
# tra i server della subscription lo gestisce sing-box internamente
# (outbound urltest "auto").
#
# Esempio con due proxy:
#   PROXY_URLS=http://proxy1:8888,http://proxy2:8888
#
# Se PROXY_URLS è vuoto, viene usato HTTP_PROXY (retro-compatibilità).
# Se entrambi sono vuoti, le richieste partono dirette (senza proxy).
PROXY_URLS=http://sing-box:8888

# Retro-compatibilità: singolo proxy HTTP/HTTPS/SOCKS5 (opzionale).
# Esempio Webshare con IP auth: http://IP:PORTA
# Esempio con credenziali: http://user:pass@host:port
HTTP_PROXY=

# User-Agent usato per scaricare la subscription URL da /configure.
# Alcuni provider lo richiedono (es. "sing-box/1.11.0").
SUBSCRIPTION_USER_AGENT=sing-box/1.11.0

# URL usato per il probe dei proxy (test live "VPN detected").
# Default: https://www.paramountplus.com/
PROXY_PROBE_URL=https://www.paramountplus.com/

# NOTA: la configurazione VPN/proxy si fa dall'UI su /configure → card VPN.
# Per attivare il proxy VLESS:
#   1) docker compose --profile vpn up -d --build
#   2) Apri https://il-tuo-dominio/configure → card "🧩 VLESS / Subscription"
#   3) Incolla la subscription URL (es. https://provider.com/sub?token=...)
#      → "🔍 Fetch servers" → scegli "Auto" o un server specifico
#   4) "💾 Save & connect" → sing-box si riavvia automaticamente (richiede la
#      systemd path unit di scripts/install-vpn-watcher.sh, oppure esegui a
#      mano `bash scripts/restart-sing-box.sh` una volta dopo il primo setup).

# URL base raggiungibile dai tuoi dispositivi.
# - Sviluppo locale (Stremio DESKTOP sullo stesso PC): http://localhost:7850
# - LAN (TV/telefono sullo stesso router): http://<IP-LAN>:7850
#   Stremio desktop potrebbe mostrare "Failed to fetch" per mixed content
#   se apri /configure via HTTPS (vedi README § Troubleshooting).
# - PRODUZIONE (Oracle Cloud, VPS, dominio pubblico):
#     http://<pub-ip>:7850          (no TLS, porta 7850 esposta)
#     https://addon.example.com     (consigliato, con nginx davanti)
BASE_URL=http://localhost:7850

# Opzionali
PORT=7850
FORCE_HQ=
